rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid}     { allow read: if request.auth != null && request.auth.uid == uid; }
    match /products/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read:   if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'جديدة';
      allow read:   if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
    match /messages/{id}    { allow create: if true; allow read, update, delete: if isAdmin(); }
  }
}
